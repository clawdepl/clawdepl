# clawdepl Build Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# Endpoint URLs
# =============================================================================
# These are injected at build time via ldflags. Override for staging/dev builds.

# Convex backend URL (user data, moltys)
CONVEX_ENDPOINT=https://colorless-gull-839.convex.site

# Provisioner service URL (sandbox management)
PROVISIONER_ENDPOINT=https://moltyverse-provisioner-production.up.railway.app

# Authentication service URL (Better Auth)
AUTH_ENDPOINT=https://molty-companions.vercel.app

# =============================================================================
# Build Settings
# =============================================================================

# Version string (set automatically in CI, override for local tagged builds)
# VERSION=dev
